{
  "name": "police-report-registration-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Manual test design and Playwright automation for police report registration.",
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "record": "playwright test --config=playwright.record.config.ts && node scripts/copy-video.js",
    "docs": "node scripts/generate-docs.mjs",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "docx": "^9.15.0",
    "exceljs": "^4.4.0",
    "typescript": "^7.0.2"
  }
}
